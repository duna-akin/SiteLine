# Copy to backend/.env and fill in what you have. Everything is optional:
# a missing integration falls back to the PRD's fallback for it.

# --- Anthropic: clause extraction (without it, only cached changes are extracted) ---
ANTHROPIC_API_KEY=
# SITELINE_CLAUDE_MODEL=claude-opus-5-5
# SITELINE_CLAUDE_EFFORT=medium

# --- Daytona: one fresh sandbox per uploaded file (without it, local parser) ---
DAYTONA_API_KEY=

# --- Photon: approver iMessages (without it, the on-screen phone) ---
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
# The Siteline line's handle (the number Photon assigned to your project), E.164
PHOTON_AGENT_HANDLE=
# Signing secret from the webhook destination pointing at $PUBLIC_BASE_URL/api/webhooks/photon
PHOTON_WEBHOOK_SECRET=
# PHOTON_PLATFORM=imessage

# --- Voice fallback: Twilio places the call, through Photon's SIP line if set ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either route through Photon SIP (caller ID = the Photon number) ...
PHOTON_SIP_SERVER=
PHOTON_SIP_USERNAME=
PHOTON_SIP_PASSWORD=
PHOTON_NUMBER=
# ... or call straight from a Twilio number
TWILIO_FROM_NUMBER=

# Public HTTPS URL of this API, for Photon and Twilio callbacks (e.g. a cloudflared tunnel)
PUBLIC_BASE_URL=

# --- Approvers' real phones (E.164). Unset = fictional 555 numbers that never get texts. ---
APPROVER_LEGAL_PHONE=
APPROVER_FINANCE_PHONE=
APPROVER_PRIVACY_PHONE=
# SITELINE_NO_REPLY_SECONDS=45

# --- Inbound email (P2): mailbox sites send redlines to ---
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
# IMAP_FOLDER=INBOX
# SITELINE_INBOUND_ADDRESS=redlines@siteline.demo
