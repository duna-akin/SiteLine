# Copy to backend/.env and fill in what you have. Everything is optional:
# a missing integration falls back to the PRD's fallback for it.

# --- OpenAI: clause extraction (without it, only cached changes are extracted) ---
OPENAI_API_KEY=

# SITELINE_OPENAI_MODEL=gpt-5
# SITELINE_OPENAI_EFFORT=medium

# --- Claude Code fallback: extraction through `claude -p` when OPENAI_API_KEY is blank ---
# Uses the local Claude Code login, or a token from `claude setup-token`.
# SITELINE_CLAUDE_BACKEND=cli
# CLAUDE_CODE_OAUTH_TOKEN=
# SITELINE_CLAUDE_CLI_MODEL=sonnet

# --- Daytona: one fresh sandbox per uploaded file (without it, local parser) ---
DAYTONA_API_KEY=

# --- Photon 2.0 (app.beta.photon.codes): approver iMessages (without it, the on-screen phone) ---
# Project API key, `pho_sk_…`
PHOTON_API_KEY=
# Project ID, `pho_prj_…` (not a key)
PHOTON_PROJECT_ID=
# Fallback iMessage line, E.164. Texts normally go out from each approver's own assigned
# shared line, looked up from Photon; this is only used when that lookup fails.
PHOTON_AGENT_HANDLE=
# Signing secret (`whsec_…`) of the webhook destination pointing at $PUBLIC_BASE_URL/api/webhooks/photon
PHOTON_WEBHOOK_SECRET=
# PHOTON_PLATFORM=imessage

# --- Voice fallback: Twilio places the call, through Photon's SIP line if set ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either route through Photon SIP (caller ID = the project's SMS/voice number, not the iMessage line) ...
PHOTON_SIP_SERVER=
PHOTON_SIP_USERNAME=
PHOTON_SIP_PASSWORD=
PHOTON_NUMBER=
# ... or call straight from a Twilio number
TWILIO_FROM_NUMBER=

# Public HTTPS URL of this API, for Photon and Twilio callbacks (an ngrok static dev domain stays fixed)
PUBLIC_BASE_URL=

# --- Approvers' real phones (E.164). Unset or blank = fictional 555 numbers that never get texts. ---
# Each must be added to the Photon project's iMessage line and text their assigned line once.
APPROVER_LEGAL_PHONE=
APPROVER_FINANCE_PHONE=
APPROVER_PRIVACY_PHONE=
# SITELINE_NO_REPLY_SECONDS=45

# --- Postgres: precedent history (without it, precedents stay in var/state.json) ---
# Local:    postgresql://localhost/siteline   (after `createdb siteline`)
# Supabase: the project's connection string from Connect, with ?sslmode=require at the end
DATABASE_URL=

# --- S3 bucket: final agreed documents that precedents cite (without it, var/documents) ---
# Supabase: Storage → Settings → S3 Connection (endpoint ends in /storage/v1/s3; New access key)
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# --- Inbound email (P2): mailbox sites send redlines to ---
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
# IMAP_FOLDER=INBOX
# Address shown to sites; defaults to IMAP_USER, or redlines@siteline.demo with no mailbox
# SITELINE_INBOUND_ADDRESS=
